# ─────────────────────────────────────────────────────────────────────────────
# Firebase Web SDK config → Google sign-in + Firestore sync
#
# 1. Create/open a project at https://console.firebase.google.com
# 2. Project settings (gear) → Your apps → Web app (</>) → copy the config
# 3. Paste the values below, then RESTART the dev server (env vars are read
#    at boot; `cp .env.local.example .env.local` first)
# 4. Authentication → Sign-in method → enable "Google"
# 5. Firestore Database → Create database (any mode)
# 6. Publish firestore.rules (in this repo) under Firestore → Rules, so every
#    user can only touch their own users/{uid} tree
# 7. Authentication → Settings → Authorized domains → add the exact origin
#    you open the app from (the app also prints it in Settings → Account)
#
# Until these are set, the app runs fully local-only: the landing page works,
# the demo works, and the sign-in buttons explain what's missing.
# ─────────────────────────────────────────────────────────────────────────────

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ─────────────────────────────────────────────────────────────────────────────
# AI note review — model endpoint (BYOK: your API key stays in the app's
# Settings, stored device-local; it is NOT part of this file)
#
# Everything here is optional — the defaults below are baked in, and you only
# set these to point the reviewer somewhere else. These are BUILD-TIME vars:
# Next.js inlines NEXT_PUBLIC_* into the client bundle when you run
# `npm run dev` / `npm run build`, so after changing them, RESTART/rebuild.
#
# Any OpenAI-compatible chat-completions endpoint works:
#   • OpenAI (default)      https://api.openai.com/v1/chat/completions
#   • a regional relay/mirror — set AI_API_URL to its /v1/chat/completions
#   • local gateway (LM Studio/Ollama-compatible) http://localhost:1234/v1/chat/completions
#
# The model must support JSON response format ({type: "json_object"}).
# ─────────────────────────────────────────────────────────────────────────────

# NEXT_PUBLIC_AI_API_URL=https://api.openai.com/v1/chat/completions
# NEXT_PUBLIC_AI_MODEL=gpt-4o-mini
# Response wait cap in milliseconds (default 30000). A longer pasted text
# (an article runs ~2-3k chars) can need well over 10s on a slow relay or a
# local model — if reviews keep stopping with "took too long", raise this.
# Requests that exceed it surface as a timeout error; the draft stays
# untouched either way.
# NEXT_PUBLIC_AI_TIMEOUT_MS=30000
